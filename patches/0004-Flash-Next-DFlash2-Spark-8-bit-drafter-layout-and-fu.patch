diff --git a/src/ops/flash_dflash/flash_dflash.cu b/src/ops/flash_dflash/flash_dflash.cu
index 13ca674..d586607 100644
--- a/src/ops/flash_dflash/flash_dflash.cu
+++ b/src/ops/flash_dflash/flash_dflash.cu
@@ -105,6 +105,101 @@ __global__ void ring_store_kernel(const bf16* k, const bf16* v, const std::int32
     }
 }
 
+// The packed projections of the Spark drafter layout. One block per (column, head) and one
+// thread per rotation pair; the block normalizes its head over 128 values and rotates it.
+struct RopeFrequencies {
+    double value[64];
+};
+
+__device__ inline float head_inverse_rms(const bf16* x, float epsilon, float* partial) {
+    const int p   = threadIdx.x;
+    const float a = __bfloat162float(x[p]), b = __bfloat162float(x[p + 64]);
+    float sum     = a * a + b * b;
+    for (int offset = 16; offset > 0; offset >>= 1) sum += __shfl_down_sync(0xffffffffU, sum, offset);
+    if ((p & 31) == 0) partial[p >> 5] = sum;
+    __syncthreads();
+    return rsqrtf((partial[0] + partial[1]) * (1.0F / 128.0F) + epsilon);
+}
+
+__device__ inline void rotate_pair(const bf16* x, const bf16* weight, float inverse, int position,
+                                   const RopeFrequencies& frequencies, float& low, float& high) {
+    const int p        = threadIdx.x;
+    const double angle = double(position) * frequencies.value[p];
+    const float reduced =
+        float(angle - nearbyint(angle * 0.159154943091895336) * 6.28318530717958648);
+    float s, c;
+    sincosf(reduced, &s, &c);
+    const float a = __bfloat162float(x[p]) * inverse * __bfloat162float(weight[p]);
+    const float b = __bfloat162float(x[p + 64]) * inverse * __bfloat162float(weight[p + 64]);
+    low           = a * c - b * s;
+    high          = b * c + a * s;
+}
+
+// packed is [(2*Hkv+Hq)*128, W]: K heads, V heads, Q heads.
+__global__ void kvq_split_kernel(const bf16* packed, const std::int32_t* positions,
+                                 const bf16* q_weight, const bf16* k_weight, bf16* q, bf16* k,
+                                 bf16* v, int kv_heads, int q_heads, float epsilon,
+                                 RopeFrequencies frequencies) {
+    __shared__ float partial[2];
+    const int column = blockIdx.x, head = blockIdx.y, p = threadIdx.x;
+    const int rows   = (2 * kv_heads + q_heads) * 128;
+    const bf16* x    = packed + std::int64_t(column) * rows + head * 128;
+    if (head >= kv_heads && head < 2 * kv_heads) {
+        bf16* out = v + (std::int64_t(column) * kv_heads + head - kv_heads) * 128;
+        out[p]      = x[p];
+        out[p + 64] = x[p + 64];
+        return;
+    }
+    const bool key     = head < kv_heads;
+    const float inverse = head_inverse_rms(x, epsilon, partial);
+    float low, high;
+    rotate_pair(x, key ? k_weight : q_weight, inverse, positions[column], frequencies, low, high);
+    bf16* out = key ? k + (std::int64_t(column) * kv_heads + head) * 128
+                    : q + (std::int64_t(column) * q_heads + head - 2 * kv_heads) * 128;
+    out[p]      = __float2bfloat16_rn(low);
+    out[p + 64] = __float2bfloat16_rn(high);
+}
+
+// packed is [2*Hkv*128, C]: K heads, V heads. K is normalized, rotated and stored; V is stored.
+__global__ void context_store_kernel(const bf16* packed, const std::int32_t* positions,
+                                     const bf16* k_weight, bf16* ring_k, __half* ring_v,
+                                     int kv_heads, int capacity, int padded, float epsilon,
+                                     RopeFrequencies frequencies) {
+    __shared__ float partial[2];
+    const int column = blockIdx.x, head = blockIdx.y, p = threadIdx.x;
+    const bf16* x    = packed + (std::int64_t(column) * 2 * kv_heads + head) * 128;
+    const int slot   = positions[column] % capacity;
+    if (head >= kv_heads) {
+        __half* out = ring_v + (std::int64_t(head - kv_heads) * padded + slot) * 128;
+        out[p]      = __float2half_rn(__bfloat162float(x[p]));
+        out[p + 64] = __float2half_rn(__bfloat162float(x[p + 64]));
+        return;
+    }
+    const float inverse = head_inverse_rms(x, epsilon, partial);
+    float low, high;
+    rotate_pair(x, k_weight, inverse, positions[column], frequencies, low, high);
+    bf16* out   = ring_k + (std::int64_t(head) * padded + slot) * 128;
+    out[p]      = __float2bfloat16_rn(low);
+    out[p + 64] = __float2bfloat16_rn(high);
+}
+
+// gate_up is [2*I, M]: gate rows, then up rows.
+__global__ void swiglu_packed_kernel(const bf16* gate_up, bf16* out, int inner) {
+    const bf16* source = gate_up + std::int64_t(blockIdx.x) * 2 * inner;
+    bf16* destination  = out + std::int64_t(blockIdx.x) * inner;
+    for (int r = blockIdx.y * blockDim.x + threadIdx.x; r < inner; r += gridDim.y * blockDim.x) {
+        const float g  = __bfloat162float(source[r]);
+        destination[r] = __float2bfloat16_rn(g / (1.0F + __expf(-g)) *
+                                             __bfloat162float(source[inner + r]));
+    }
+}
+
+RopeFrequencies rope_frequencies(float theta) {
+    RopeFrequencies out;
+    for (int i = 0; i < 64; ++i) out.value[i] = std::pow(double(theta), -double(i) / 64.0);
+    return out;
+}
+
 constexpr int kTop = 16, kTopThreads = 1024;
 
