+// The Spark drafter layout stores projections of one input in one weight, so their outputs arrive
+// packed. packed is BF16 [(2*Hkv+Hq)*128, W] holding K heads, V heads, then Q heads per column.
+// q [128,Hq,W] and k [128,Hkv,W] receive the per-head RMSNorm and RoPE of rmsnorm_rope.h
+// (positions I32 [W]); v [128,Hkv,W] receives V unchanged. Outputs are completely overwritten.
+void kvq_split_rmsnorm_rope(const Tensor& packed, const Tensor& positions, const Tensor& q_weight,
+                            const Tensor& k_weight, float epsilon, float theta, Tensor& q,
+                            Tensor& k, Tensor& v, CudaExecutionView execution);
+
+// Context K/V of `count` columns into one cyclic layer, from packed BF16 [2*Hkv*128, C] (K heads,
+// then V heads): K is normalized and rotated as above and stored BF16, V is stored FP16, both at
+// slot positions[c] mod capacity of dense [128, padded_capacity, Hkv] rings.
+void context_kv_store(const Tensor& packed, const Tensor& positions, const Tensor& k_weight,
+                      float epsilon, float theta, std::int32_t count, Tensor& ring_k,
+                      Tensor& ring_v, std::int32_t capacity, CudaExecutionView execution);
+
+// out[r,m] = BF16(SiLU(gate_up[r,m]) * gate_up[I+r,m]); gate_up is BF16 [2*I, M], out [I, M].
+void swiglu_packed(const Tensor& gate_up, Tensor& out, CudaExecutionView execution);
+
 // The 16 largest of the first `valid` rows of each column of BF16 logits [V,M], descending, ties
 // to the lower row. ids is I32 [16,M], scores FP32 [16,M] (the logits' values).
 void logits_top16(const Tensor& logits, std::int32_t valid, std::int32_t columns, Tensor& ids,
