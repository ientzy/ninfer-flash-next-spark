@@ -246,6 +341,56 @@ void ring_store(const Tensor& k, const Tensor& v, const Tensor& positions, std::
     check_launch();
 }
 
+void kvq_split_rmsnorm_rope(const Tensor& packed, const Tensor& positions, const Tensor& q_weight,
+                            const Tensor& k_weight, float epsilon, float theta, Tensor& q,
+                            Tensor& k, Tensor& v, CudaExecutionView execution) {
+    const int q_heads = q.ne[1], kv_heads = k.ne[1], width = packed.ne[1];
+    require(packed.dtype == DType::BF16 && packed.is_contiguous() && q.ne[0] == 128 &&
+                k.ne[0] == 128 && v.ne[0] == 128 && v.ne[1] == kv_heads &&
+                packed.ne[0] == (2 * kv_heads + q_heads) * 128 && width > 0 &&
+                q.numel() == std::int64_t(128) * q_heads * width &&
+                k.numel() == std::int64_t(128) * kv_heads * width && v.numel() == k.numel() &&
+                positions.dtype == DType::I32 && positions.numel() >= width &&
+                q_weight.ne[0] == 128 && k_weight.ne[0] == 128 && epsilon > 0 && theta > 0,
+            "kvq_split_rmsnorm_rope: invalid operands");
+    kvq_split_kernel<<<dim3(width, 2 * kv_heads + q_heads), 64, 0, execution.stream()>>>(
+        static_cast<const bf16*>(packed.data), static_cast<const std::int32_t*>(positions.data),
+        static_cast<const bf16*>(q_weight.data), static_cast<const bf16*>(k_weight.data),
+        static_cast<bf16*>(q.data), static_cast<bf16*>(k.data), static_cast<bf16*>(v.data),
+        kv_heads, q_heads, epsilon, rope_frequencies(theta));
+    check_launch();
+}
+
+void context_kv_store(const Tensor& packed, const Tensor& positions, const Tensor& k_weight,
+                      float epsilon, float theta, std::int32_t count, Tensor& ring_k,
+                      Tensor& ring_v, std::int32_t capacity, CudaExecutionView execution) {
+    const int padded = ring_k.ne[1], heads = ring_k.ne[2];
+    require(packed.dtype == DType::BF16 && packed.is_contiguous() && ring_k.ne[0] == 128 &&
+                ring_v.ne[0] == 128 && ring_v.ne[1] == padded && ring_v.ne[2] == heads &&
+                ring_k.dtype == DType::BF16 && ring_v.dtype == DType::FP16 &&
+                packed.ne[0] == 2 * heads * 128 && count > 0 && count <= packed.ne[1] &&
+                positions.dtype == DType::I32 && positions.numel() >= count && capacity > 0 &&
+                capacity <= padded && k_weight.ne[0] == 128 && epsilon > 0 && theta > 0,
+            "context_kv_store: invalid operands");
+    context_store_kernel<<<dim3(count, 2 * heads), 64, 0, execution.stream()>>>(
+        static_cast<const bf16*>(packed.data), static_cast<const std::int32_t*>(positions.data),
+        static_cast<const bf16*>(k_weight.data), static_cast<bf16*>(ring_k.data),
+        static_cast<__half*>(ring_v.data), heads, capacity, padded, epsilon,
+        rope_frequencies(theta));
+    check_launch();
+}
+
+void swiglu_packed(const Tensor& gate_up, Tensor& out, CudaExecutionView execution) {
+    const int inner = out.ne[0], columns = gate_up.ne[1];
+    require(gate_up.dtype == DType::BF16 && out.dtype == DType::BF16 && inner > 0 &&
+                gate_up.ne[0] == 2 * inner && columns > 0 &&
+                out.numel() == std::int64_t(inner) * columns && gate_up.data != out.data,
+            "swiglu_packed: invalid operands");
+    swiglu_packed_kernel<<<dim3(columns, 8), 256, 0, execution.stream()>>>(
+        static_cast<const bf16*>(gate_up.data), static_cast<bf16*>(out.data), inner);
+    check_launch();
+}
+
 void logits_top16(const Tensor& logits, std::int32_t valid, std::int32_t columns, Tensor& ids,
                   Tensor& scores, CudaExecutionView execution) {
     require(logits.dtype == DType::BF16 && valid >= kTop && valid <= logits.ne[0] && columns > 0 &&
