diff --git a/include/ninfer/ops/flash_dflash.h b/include/ninfer/ops/flash_dflash.h
new file mode 100644
index 0000000..47a8fb7
--- /dev/null
+++ b/include/ninfer/ops/flash_dflash.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include "core/device.h"
+#include "core/tensor.h"
+
+// Shape-generic glue for the Qwen3.8-Flash-Next DFlash2 drafter (hidden 2560). The fused DFlash2
+// Ops of the 27B and GLM drafters are specialized for hidden 5120 and 4096; these compose the same
+// mathematics from ops::linear and small element-wise kernels. Every tensor is contiguous and
+// belongs to execution.device(); no Op here owns workspace or state, and all support Graph capture.
+
+namespace ninfer::ops {
+
+// out[d, tap, c] = BF16(mean_s residual[d, s, first + c]) for c < count.
+// residual is BF16 [H,S,M]; out is BF16 [H,T,C] with tap < T and count <= C.
+void hc_stream_mean(const Tensor& residual, std::int32_t first, std::int32_t count,
+                    std::int32_t tap, Tensor& out, CudaExecutionView execution);
+
+// out[d,m] = BF16(x[d,m] * weight[d] / sqrt(mean_d x[d,m]^2 + epsilon)), BF16 [H,M], M = columns.
+// out may be x itself.
+void plain_rmsnorm_columns(const Tensor& x, const Tensor& weight, float epsilon,
+                           std::int32_t columns, Tensor& out, CudaExecutionView execution);
+
+// DFlash2 dynamic grouped convolution, input side. n is the normalized branch input BF16 [H,W,B],
+// coefficients is BF16 [4G, W*B] with row(side,tap,g) = (side*2+tap)*G+g and G = H/16, base is BF16
+// [H,2,2] (channel, tap, side):
+//   prepared[h,i,b] = (base[h,0,0] + c[0,0,g,i,b]) * n[h,i,b]
+//                   + I(i>0) * (base[h,1,0] + c[0,1,g,i,b]) * n[h,i-1,b],  g = h/16.
+void dynamic_conv_prepare(const Tensor& n, const Tensor& coefficients, const Tensor& base,
+                          Tensor& prepared, CudaExecutionView execution);
+
+// Output side, added to the residual: with z the branch's projected output BF16 [H,W,B],
+//   residual[h,i,b] += (base[h,0,1] + c[1,0,g,i,b]) * z[h,i,b]
+//                    + I(i>0) * (base[h,1,1] + c[1,1,g,i,b]) * z[h,i-1,b].
+void dynamic_conv_add(const Tensor& z, const Tensor& coefficients, const Tensor& base,
+                      Tensor& residual, CudaExecutionView execution);
+
+// out = BF16(SiLU(gate) * up), all BF16 with `elements` words.
+void swiglu_product(const Tensor& gate, const Tensor& up, std::int64_t elements, Tensor& out,
+                    CudaExecutionView execution);
+
+// Stores context K/V of `count` columns into one cyclic layer: k is BF16 [D,Hkv,C] already
+// normalized and rotated, v is BF16 [D,Hkv,C], positions is I32 [C]. ring_k is BF16 and ring_v
+// FP16, both dense [D, padded_capacity, Hkv]; position p goes to slot p mod capacity.
+void ring_store(const Tensor& k, const Tensor& v, const Tensor& positions, std::int32_t count,
+                Tensor& ring_k, Tensor& ring_v, std::int32_t capacity, CudaExecutionView execution);
+
+// out[d,(W-1)*b+i-1] = BF16(residual[d,i,b] * weight[d] / sqrt(mean_d residual^2 + epsilon)),
+// 1 <= i < W. residual is BF16 [H,W,B]; out is BF16 [H,(W-1)*B].
+void rmsnorm_tail(const Tensor& residual, const Tensor& weight, float epsilon, Tensor& out,
+                  CudaExecutionView execution);
+
+// The 16 largest of the first `valid` rows of each column of BF16 logits [V,M], descending, ties
+// to the lower row. ids is I32 [16,M], scores FP32 [16,M] (the logits' values).
+void logits_top16(const Tensor& logits, std::int32_t valid, std::int32_t columns, Tensor& ids,
+                  Tensor& scores, CudaExecutionView execution);
+
+} // namespace ninfer::ops
