diff --git a/src/ops/flash_dflash/flash_dflash.cu b/src/ops/flash_dflash/flash_dflash.cu
new file mode 100644
index 0000000..13ca674
--- /dev/null
+++ b/src/ops/flash_dflash/flash_dflash.cu
@@ -0,0 +1,261 @@
+#include "ninfer/ops/flash_dflash.h"
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <climits>
+#include <cmath>
+#include <cstdint>
+#include <stdexcept>
+
+namespace ninfer::ops {
+namespace {
+
+using bf16 = __nv_bfloat16;
+
+void require(bool ok, const char* message) {
+    if (!ok) throw std::invalid_argument(message);
+}
+
+void check_launch() { CUDA_CHECK(cudaGetLastError()); }
+
+__global__ void stream_mean_kernel(const bf16* residual, bf16* out, int hidden, int streams,
+                                   int first, int tap, int taps) {
+    const int column = blockIdx.x;
+    const bf16* source = residual + std::int64_t(first + column) * streams * hidden;
+    bf16* destination  = out + (std::int64_t(column) * taps + tap) * hidden;
+    const float scale  = 1.0F / float(streams);
+    for (int d = threadIdx.x; d < hidden; d += blockDim.x) {
+        float sum = 0;
+        for (int s = 0; s < streams; ++s) sum += __bfloat162float(source[s * hidden + d]);
+        destination[d] = __float2bfloat16_rn(sum * scale);
+    }
+}
+
+// One block per column; a block-wide sum of squares, then the scaled write.
+template <bool Tail>
+__global__ void rmsnorm_kernel(const bf16* x, const bf16* weight, bf16* out, int hidden,
+                               float epsilon, int width) {
+    __shared__ float partial[32];
+    __shared__ float inverse;
+    // Tail: output column c is input column (c / (width-1)) * width + c % (width-1) + 1.
+    const int c = blockIdx.x;
+    const int input_column = Tail ? (c / (width - 1)) * width + c % (width - 1) + 1 : c;
+    const bf16* source = x + std::int64_t(input_column) * hidden;
+    float sum = 0;
+    for (int d = threadIdx.x; d < hidden; d += blockDim.x) {
+        const float v = __bfloat162float(source[d]);
+        sum += v * v;
+    }
+    for (int offset = 16; offset > 0; offset >>= 1) sum += __shfl_down_sync(0xffffffffU, sum, offset);
+    if ((threadIdx.x & 31) == 0) partial[threadIdx.x >> 5] = sum;
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float total = 0;
+        for (int i = 0; i < int(blockDim.x >> 5); ++i) total += partial[i];
+        inverse = rsqrtf(total / float(hidden) + epsilon);
+    }
+    __syncthreads();
+    const float scale = inverse;
+    bf16* destination = out + std::int64_t(c) * hidden;
+    for (int d = threadIdx.x; d < hidden; d += blockDim.x)
+        destination[d] =
+            __float2bfloat16_rn(__bfloat162float(source[d]) * scale * __bfloat162float(weight[d]));
+}
+
+// base is [H,2,2] (channel, tap, side); coefficient rows are (side*2+tap)*G+g.
+template <bool Add>
+__global__ void dynamic_conv_kernel(const bf16* input, const bf16* coefficients, const bf16* base,
+                                    bf16* out, int hidden, int width, int groups) {
+    const int column = blockIdx.x, i = column % width, side = Add ? 1 : 0;
+    const bf16* current  = input + std::int64_t(column) * hidden;
+    const bf16* previous = current - hidden;
+    const bf16* c        = coefficients + std::int64_t(column) * 4 * groups + side * 2 * groups;
+    const bf16* b        = base + std::int64_t(side) * 2 * hidden;
+    bf16* destination    = out + std::int64_t(column) * hidden;
+    for (int h = threadIdx.x; h < hidden; h += blockDim.x) {
+        const int g = h >> 4;
+        float value = (__bfloat162float(b[h]) + __bfloat162float(c[g])) * __bfloat162float(current[h]);
+        if (i > 0)
+            value += (__bfloat162float(b[hidden + h]) + __bfloat162float(c[groups + g])) *
+                     __bfloat162float(previous[h]);
+        if (Add) value += __bfloat162float(destination[h]);
+        destination[h] = __float2bfloat16_rn(value);
+    }
+}
+
+__global__ void swiglu_kernel(const bf16* gate, const bf16* up, bf16* out, std::int64_t elements) {
+    const std::int64_t stride = std::int64_t(gridDim.x) * blockDim.x;
+    for (std::int64_t i = std::int64_t(blockIdx.x) * blockDim.x + threadIdx.x; i < elements;
+         i += stride) {
+        const float g = __bfloat162float(gate[i]);
+        out[i] = __float2bfloat16_rn(g / (1.0F + __expf(-g)) * __bfloat162float(up[i]));
+    }
+}
+
+__global__ void ring_store_kernel(const bf16* k, const bf16* v, const std::int32_t* positions,
+                                  bf16* ring_k, __half* ring_v, int head_dim, int heads,
+                                  int capacity, int padded) {
+    const int column = blockIdx.x, head = blockIdx.y;
+    const int slot   = positions[column] % capacity;
+    const std::int64_t source      = (std::int64_t(column) * heads + head) * head_dim;
+    const std::int64_t destination = (std::int64_t(head) * padded + slot) * head_dim;
+    for (int d = threadIdx.x; d < head_dim; d += blockDim.x) {
+        ring_k[destination + d] = k[source + d];
+        ring_v[destination + d] = __float2half_rn(__bfloat162float(v[source + d]));
+    }
+}
+
+constexpr int kTop = 16, kTopThreads = 1024;
+
+__device__ inline bool better(float a, int ia, float b, int ib) {
+    return a > b || (a == b && ia < ib);
+}
+
+// One block per column. Each thread keeps the sorted top 16 of its strided rows, then the block
+// takes the best remaining head 16 times.
+__global__ void top16_kernel(const bf16* logits, std::int64_t column_stride, int valid,
+                             std::int32_t* ids, float* scores) {
+    __shared__ float head_value[kTopThreads];
+    __shared__ int head_id[kTopThreads];
+    __shared__ int winner;
+    const int column  = blockIdx.x, t = threadIdx.x;
+    const bf16* source = logits + std::int64_t(column) * column_stride;
+    float values[kTop];
+    int rows[kTop];
+    int count = 0;
+    for (int r = t; r < valid; r += kTopThreads) {
+        const float v = __bfloat162float(source[r]);
+        if (count == kTop && !better(v, r, values[kTop - 1], rows[kTop - 1])) continue;
+        int j = count < kTop ? count++ : kTop - 1;
+        for (; j > 0 && better(v, r, values[j - 1], rows[j - 1]); --j) {
+            values[j] = values[j - 1];
+            rows[j]   = rows[j - 1];
+        }
+        values[j] = v;
+        rows[j]   = r;
+    }
+    int next = 0;
+    for (int rank = 0; rank < kTop; ++rank) {
+        head_value[t] = next < count ? values[next] : -INFINITY;
+        head_id[t]    = next < count ? rows[next] : INT_MAX;
+        __syncthreads();
+        // Tree reduction over the block's heads; thread 0 ends with the winner's thread index.
+        if (t == 0) {
+            int best = 0;
+            for (int i = 1; i < kTopThreads; ++i)
+                if (better(head_value[i], head_id[i], head_value[best], head_id[best])) best = i;
+            winner                 = best;
+            ids[column * kTop + rank]    = head_id[best];
+            scores[column * kTop + rank] = head_value[best];
+        }
+        __syncthreads();
+        if (winner == t) ++next;
+        __syncthreads();
+    }
+}
+
+} // namespace
+
+void hc_stream_mean(const Tensor& residual, std::int32_t first, std::int32_t count,
+                    std::int32_t tap, Tensor& out, CudaExecutionView execution) {
+    const int hidden = residual.ne[0], streams = residual.ne[1];
+    require(residual.dtype == DType::BF16 && out.dtype == DType::BF16 && out.ne[0] == hidden &&
+                first >= 0 && count > 0 && first + count <= residual.ne[2] && tap >= 0 &&
+                tap < out.ne[1] && count <= out.ne[2],
+            "hc_stream_mean: invalid operands");
+    stream_mean_kernel<<<count, 256, 0, execution.stream()>>>(
+        static_cast<const bf16*>(residual.data), static_cast<bf16*>(out.data), hidden, streams,
+        first, tap, out.ne[1]);
+    check_launch();
+}
+
+void plain_rmsnorm_columns(const Tensor& x, const Tensor& weight, float epsilon,
+                           std::int32_t columns, Tensor& out, CudaExecutionView execution) {
+    require(x.dtype == DType::BF16 && out.dtype == DType::BF16 && weight.ne[0] == x.ne[0] &&
+                out.ne[0] == x.ne[0] && columns > 0,
+            "plain_rmsnorm_columns: invalid operands");
+    rmsnorm_kernel<false><<<columns, 256, 0, execution.stream()>>>(
+        static_cast<const bf16*>(x.data), static_cast<const bf16*>(weight.data),
+        static_cast<bf16*>(out.data), x.ne[0], epsilon, 0);
+    check_launch();
+}
+
+void rmsnorm_tail(const Tensor& residual, const Tensor& weight, float epsilon, Tensor& out,
+                  CudaExecutionView execution) {
+    const int hidden = residual.ne[0], width = residual.ne[1], batch = residual.ne[2];
+    require(residual.dtype == DType::BF16 && out.dtype == DType::BF16 && width >= 2 &&
+                out.ne[0] == hidden && out.ne[1] == (width - 1) * batch && weight.ne[0] == hidden,
+            "rmsnorm_tail: invalid operands");
+    rmsnorm_kernel<true><<<(width - 1) * batch, 256, 0, execution.stream()>>>(
+        static_cast<const bf16*>(residual.data), static_cast<const bf16*>(weight.data),
+        static_cast<bf16*>(out.data), hidden, epsilon, width);
+    check_launch();
+}
+
+void dynamic_conv_prepare(const Tensor& n, const Tensor& coefficients, const Tensor& base,
+                          Tensor& prepared, CudaExecutionView execution) {
+    const int hidden = n.ne[0], width = n.ne[1], batch = n.ne[2], groups = hidden / 16;
+    require(hidden % 16 == 0 && coefficients.ne[0] == 4 * groups &&
+                coefficients.ne[1] == width * batch && base.ne[0] == hidden && base.ne[1] == 2 &&
+                base.ne[2] == 2 && prepared.ne[0] == hidden && prepared.data != n.data,
+            "dynamic_conv_prepare: invalid operands");
+    dynamic_conv_kernel<false><<<width * batch, 256, 0, execution.stream()>>>(
+        static_cast<const bf16*>(n.data), static_cast<const bf16*>(coefficients.data),
+        static_cast<const bf16*>(base.data), static_cast<bf16*>(prepared.data), hidden, width,
+        groups);
+    check_launch();
+}
+
+void dynamic_conv_add(const Tensor& z, const Tensor& coefficients, const Tensor& base,
+                      Tensor& residual, CudaExecutionView execution) {
+    const int hidden = z.ne[0], width = z.ne[1], batch = z.ne[2], groups = hidden / 16;
+    require(hidden % 16 == 0 && coefficients.ne[0] == 4 * groups &&
+                coefficients.ne[1] == width * batch && base.ne[0] == hidden &&
+                residual.ne[0] == hidden && residual.data != z.data,
+            "dynamic_conv_add: invalid operands");
+    dynamic_conv_kernel<true><<<width * batch, 256, 0, execution.stream()>>>(
+        static_cast<const bf16*>(z.data), static_cast<const bf16*>(coefficients.data),
+        static_cast<const bf16*>(base.data), static_cast<bf16*>(residual.data), hidden, width,
+        groups);
+    check_launch();
+}
+
+void swiglu_product(const Tensor& gate, const Tensor& up, std::int64_t elements, Tensor& out,
+                    CudaExecutionView execution) {
+    require(elements > 0, "swiglu_product: invalid operands");
+    const auto blocks = static_cast<unsigned>((elements + 255) / 256 < 1024 ? (elements + 255) / 256
+                                                                            : 1024);
+    swiglu_kernel<<<blocks, 256, 0, execution.stream()>>>(
+        static_cast<const bf16*>(gate.data), static_cast<const bf16*>(up.data),
+        static_cast<bf16*>(out.data), elements);
+    check_launch();
+}
+
+void ring_store(const Tensor& k, const Tensor& v, const Tensor& positions, std::int32_t count,
+                Tensor& ring_k, Tensor& ring_v, std::int32_t capacity,
+                CudaExecutionView execution) {
+    const int head_dim = ring_k.ne[0], padded = ring_k.ne[1], heads = ring_k.ne[2];
+    require(count > 0 && capacity > 0 && capacity <= padded && ring_v.ne[0] == head_dim &&
+                ring_v.ne[1] == padded && ring_v.ne[2] == heads && k.numel() >= std::int64_t(count) * head_dim * heads &&
+                v.numel() >= std::int64_t(count) * head_dim * heads,
+            "ring_store: invalid operands");
+    ring_store_kernel<<<dim3(count, heads), 128, 0, execution.stream()>>>(
+        static_cast<const bf16*>(k.data), static_cast<const bf16*>(v.data),
+        static_cast<const std::int32_t*>(positions.data), static_cast<bf16*>(ring_k.data),
+        static_cast<__half*>(ring_v.data), head_dim, heads, capacity, padded);
+    check_launch();
+}
+
+void logits_top16(const Tensor& logits, std::int32_t valid, std::int32_t columns, Tensor& ids,
+                  Tensor& scores, CudaExecutionView execution) {
+    require(logits.dtype == DType::BF16 && valid >= kTop && valid <= logits.ne[0] && columns > 0 &&
+                ids.ne[0] == kTop && scores.ne[0] == kTop && ids.dtype == DType::I32 &&
+                scores.dtype == DType::FP32,
+            "logits_top16: invalid operands");
+    top16_kernel<<<columns, kTopThreads, 0, execution.stream()>>>(
+        static_cast<const bf16*>(logits.data), logits.ne[0], valid,
+        static_cast<std::int32_t*>(ids.data), static_cast<float*>(scores.data));
+    check_launch();
+}
+
+} // namespace ninfer::ops
