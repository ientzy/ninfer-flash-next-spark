+#pragma once
+
+// Program-owned state of the DFlash2 drafter: the context ring, the captured target features and
+// the proposal's io words, for one sequence at a time. The ring describes positions
+// [start, frontier) of (sequence, generation); anything else makes it stale and the round falls
+// back to MTP until a forward starts it again.
+
+#include "core/arena.h"
+#include "core/buffer.h"
+#include "core/cyclic_kv_cache.h"
+#include "models/qwen4_exp/execution/dflash.h"
+
+#include <optional>
+#include <vector>
+
+namespace ninfer::models::qwen4_exp::detail {
+
+struct DraftRuntime {
+    DraftRuntime(const execution::Parameters&, Device, std::uint32_t draft_tokens);
+
+    [[nodiscard]] execution::DraftRing ring() { return {layers, keys, values}; }
+
+    DeviceBuffer ring_memory, io_memory, arena_memory;
+    std::optional<StateImageStorage> storage;
+    std::vector<CyclicKVCacheLayerView> layers;
+    std::vector<Tensor> keys, values;
+    std::optional<MemoryArena> io, arena;
+    Tensor features;       // BF16 [H, taps, capacity]
+    Tensor positions;      // I32 [capacity]
+    Tensor words;          // I32 [48]: anchor, frontier and valid columns at 0, 16, 32
+    Tensor zero;           // I64 [1]
+    execution::DraftProposal call;
+    std::vector<std::int32_t> host_positions;
+    std::uint32_t capacity = 0, width = 0, minimum = 1;
+    bool live              = false;
+    std::uint64_t sequence = 0, generation = 0;
+    std::uint32_t start = 0, frontier = 0;
+    std::uint64_t proposals = 0, fallbacks = 0;
+};
+
+} // namespace ninfer::models::qwen4_exp::detail
