diff --git a/src/models/qwen4_exp/program/dflash.cpp b/src/models/qwen4_exp/program/dflash.cpp
new file mode 100644
index 0000000..30b92cd
--- /dev/null
+++ b/src/models/qwen4_exp/program/dflash.cpp
@@ -0,0 +1,155 @@
+#include "models/qwen4_exp/program/dflash.h"
+#include "models/qwen4_exp/program/internal.h"
+
+#include "core/transfer.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace ninfer::models::qwen4_exp::detail {
+namespace {
+constexpr std::size_t kArenaBytes = 256ULL << 20;
+constexpr std::size_t kIoBytes    = 1ULL << 20;
+
+std::uint32_t minimum_context() {
+    const char* value = std::getenv("NINFER_FLASH_DFLASH2_MIN_CONTEXT");
+    const long n      = value ? std::strtol(value, nullptr, 10) : 1;
+    return n < 1 ? 1U : static_cast<std::uint32_t>(n);
+}
+} // namespace
+
+DraftRuntime::DraftRuntime(const execution::Parameters& parameters, Device device,
+                           std::uint32_t draft_tokens)
+    : io_memory(device, kIoBytes), arena_memory(device, kArenaBytes) {
+    const auto& config = parameters.profile->config.draft.value();
+    const int h        = dimension(parameters.profile->config.text.hidden);
+    const int taps     = dimension(config.target_layer_ids.size());
+    const int kh       = dimension(config.attention.num_key_value_heads);
+    const int d        = dimension(config.attention.head_dim);
+    capacity           = config.sliding_window.value();
+    width              = draft_tokens + 1;
+    minimum            = minimum_context();
+    const int k        = dimension(draft_tokens), w = dimension(width), c = dimension(capacity);
+
+    StateImageBuilder builder;
+    const auto layout = plan_cyclic_kv_cache(builder, config.num_hidden_layers, capacity, kh, d);
+    const auto image  = builder.finish();
+    ring_memory       = DeviceBuffer(device, image.image_bytes + 4096);
+    ring_memory.fill(0);
+    io_memory.fill(0);
+    storage.emplace(ring_memory.span(), image);
+    io.emplace(io_memory.span());
+    arena.emplace(arena_memory.span());
+    zero = io->alloc(DType::I64, {1});
+    const CyclicKVCacheView view(*storage, layout);
+    for (std::uint32_t l = 0; l < config.num_hidden_layers; ++l) {
+        layers.push_back(view.layer_view(l, zero));
+        keys.push_back(storage->tensor(layout.k, 0, l));
+        values.push_back(storage->tensor(layout.v, 0, l));
+    }
+    words     = io->alloc(DType::I32, {48}); // one word per 64 bytes: Ops want aligned operands
+    positions = io->alloc(DType::I32, {c});
+    host_positions.resize(capacity);
+    call.anchors       = words.slice(0, 0, 1);
+    call.frontiers     = words.slice(0, 16, 1);
+    call.valid_columns = words.slice(0, 32, 1);
+    call.ids           = io->alloc(DType::I32, {w, 1});
+    call.positions     = io->alloc(DType::I32, {w, 1});
+    call.candidates    = io->alloc(DType::I32, {16, k, 1});
+    call.scores        = io->alloc(DType::FP32, {16, k, 1});
+    call.proposal_q    = io->alloc(DType::FP32, {16, k, 1});
+    call.drafts        = io->alloc(DType::I32, {k, 1});
+    const auto config_span = io->alloc_bytes(sizeof(ops::SamplingConfig));
+    const ops::SamplingConfig greedy{};
+    io_memory.copy_from_host(&greedy, sizeof(greedy),
+                             static_cast<const char*>(config_span.data) -
+                                 static_cast<const char*>(io_memory.data()));
+    call.sampling = static_cast<const ops::SamplingConfig*>(config_span.data);
+    // The features live at the head of the scratch arena and stay there.
+    features = arena->alloc(DType::BF16, {h, taps, c});
+}
+
+void RankProgramImpl::draft_append(std::uint32_t first, std::uint32_t count) {
+    auto& d = *draft;
+    for (std::uint32_t i = 0; i < count; ++i)
+        d.host_positions[i] = static_cast<std::int32_t>(first + i);
+    copy_bytes({d.positions.data, count * sizeof(std::int32_t), cuda.device()},
+               {d.host_positions.data(), count * sizeof(std::int32_t), Device::cpu()}, cuda);
+    execution::draft_append_context(parameters, *d.arena, d.features, d.positions,
+                                    static_cast<std::int32_t>(count), d.ring(), cuda);
+}
+
+// A committed-by-construction forward (prefill, replay or a plain step): its captured columns are
+// the context of positions [frontier + tokens - n, frontier + tokens).
+void RankProgramImpl::draft_observe_forward() {
+    auto& d       = *draft;
+    const auto& f = *compute;
+    if (f.rows.size() != 1 || !std::holds_alternative<ForwardWork>(f.request.work.operation) ||
+        f.rows[0].ids.size() != f.tokens || !f.tokens) {
+        d.live = false;
+        return;
+    }
+    const auto& row  = f.rows[0];
+    const auto n     = std::min(f.tokens, d.capacity);
+    const auto first = row.main_frontier + f.tokens - n;
+    const bool same  = d.live && d.sequence == row.member.sequence.value &&
+                       d.generation == row.member.sequence.generation &&
+                       d.frontier == row.main_frontier;
+    if (!same) d.start = first;
+    draft_append(first, n);
+    d.live       = true;
+    d.sequence   = row.member.sequence.value;
+    d.generation = row.member.sequence.generation;
+    d.frontier   = row.main_frontier + f.tokens;
+}
+
+// A verify round kept its first `accepted` input columns.
+void RankProgramImpl::draft_observe_commit(std::uint32_t accepted) {
+    auto& d       = *draft;
+    const auto& f = *compute;
+    const auto& row = f.rows[0];
+    if (f.rows.size() != 1 || !d.live || d.sequence != row.member.sequence.value ||
+        d.generation != row.member.sequence.generation || d.frontier != row.main_frontier) {
+        d.live = false;
+        return;
+    }
+    if (!accepted) return;
+    draft_append(row.main_frontier, accepted);
+    d.frontier += accepted;
+}
+
+bool RankProgramImpl::draft_propose(std::vector<TokenId>& out, std::uint32_t extent) {
+    auto& d         = *draft;
+    const auto& row = compute->rows[0];
+    const auto f    = row.main_frontier;
+    const auto need = f > d.capacity ? f - d.capacity : 0;
+    if (!extent || row.ids.size() != 1 || !d.live || d.sequence != row.member.sequence.value ||
+        d.generation != row.member.sequence.generation || d.frontier != f || d.start > need ||
+        f - d.start < d.minimum) {
+        ++d.fallbacks;
+        return false;
+    }
+    std::int32_t words[48]{};
+    words[0]  = row.ids[0];
+    words[16] = static_cast<std::int32_t>(f);
+    words[32] = static_cast<std::int32_t>(d.width);
+    copy_bytes({d.words.data, sizeof(words), cuda.device()}, {words, sizeof(words), Device::cpu()},
+               cuda);
+    d.call.max_context = f;
+    execution::draft_propose(parameters, *d.arena, d.call, d.ring(), cuda);
+    std::int32_t ids[16]{};
+    const auto k = d.width - 1;
+    copy_bytes({ids, k * sizeof(std::int32_t), Device::cpu()},
+               {d.call.drafts.data, k * sizeof(std::int32_t), cuda.device()}, cuda);
+    const auto limit = static_cast<std::int32_t>(parameters.profile->public_tokens);
+    for (std::uint32_t i = 0; i < extent; ++i)
+        if (ids[i] < 0 || ids[i] >= limit) {
+            ++d.fallbacks;
+            return false;
+        }
+    out.assign(ids, ids + extent);
+    ++d.proposals;
+    return true;
+}
+
+} // namespace ninfer::models::qwen4_exp::detail
