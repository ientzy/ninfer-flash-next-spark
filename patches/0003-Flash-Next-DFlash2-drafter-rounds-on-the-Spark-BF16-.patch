diff --git a/src/models/qwen4_exp/execution/dflash.cpp b/src/models/qwen4_exp/execution/dflash.cpp
new file mode 100644
index 0000000..5714c2e
--- /dev/null
+++ b/src/models/qwen4_exp/execution/dflash.cpp
@@ -0,0 +1,145 @@
+#include "models/qwen4_exp/execution/dflash.h"
+#include "models/qwen4_exp/execution/text.h"
+
+#include "ninfer/ops/candidate_selector.h"
+#include "ninfer/ops/embedding.h"
+#include "ninfer/ops/flash_dflash.h"
+#include "ninfer/ops/linear.h"
+#include "ninfer/ops/rmsnorm_rope.h"
+#include "ninfer/ops/sequence.h"
+#include "ninfer/ops/sliding_window_attention.h"
+
+#include <cmath>
+#include <stdexcept>
+
+namespace ninfer::models::qwen4_exp::execution {
+namespace {
+void project(const Tensor& x, const LinearParameters& p, Tensor& out, CudaExecutionView cuda) {
+    ops::linear(x, p.weight, out, cuda);
+}
+} // namespace
+
+void draft_append_context(const Parameters& parameters, MemoryArena& arena, const Tensor& features,
+                          const Tensor& positions, std::int32_t count, const DraftRing& ring,
+                          CudaExecutionView cuda) {
+    const auto& p      = parameters.draft.value();
+    const auto& config = parameters.profile->config.draft.value();
+    const int h        = features.ne[0], taps = features.ne[1];
+    const int d        = dimension(config.attention.head_dim);
+    const int heads    = dimension(config.attention.num_key_value_heads);
+    if (count < 1 || count > features.ne[2] || count > positions.ne[0])
+        throw std::invalid_argument("Qwen4Exp DFlash2: invalid context column count");
+    auto scope     = arena.scope();
+    const auto x   = features.view({h * taps, features.ne[2]}).slice(1, 0, count);
+    auto projected = arena.alloc(DType::BF16, {h, count});
+    project(x, p.feature_projection, projected, cuda);
+    ops::plain_rmsnorm_columns(projected, p.context_norm, config.rms_norm_eps, count, projected,
+                               cuda);
+    auto key    = arena.alloc(DType::BF16, {d * heads, count});
+    auto value  = arena.alloc(DType::BF16, {d * heads, count});
+    const auto where = positions.slice(0, 0, count);
+    for (std::size_t l = 0; l < p.layers.size(); ++l) {
+        const auto& layer = p.layers[l];
+        project(projected, layer.context_key, key, cuda);
+        project(projected, layer.context_value, value, cuda);
+        auto heads_view = key.view({d, heads, count});
+        ops::rmsnorm_rope(where, layer.key_norm, config.rms_norm_eps, config.rope_theta,
+                          heads_view, cuda);
+        ops::ring_store(heads_view, value.view({d, heads, count}), where, count, ring.keys[l],
+                        ring.values[l], dimension(ring.layers[l].capacity), cuda);
+    }
+}
+
+void draft_propose(const Parameters& parameters, MemoryArena& arena, const DraftProposal& call,
+                   const DraftRing& ring, CudaExecutionView cuda) {
+    const auto& p       = parameters.draft.value();
+    const auto& profile = *parameters.profile;
+    const auto& config  = profile.config.draft.value();
+    const auto& extra   = config.dflash2.value();
+    const int h = dimension(profile.config.text.hidden), w = call.ids.ne[0], k = w - 1;
+    const int d = dimension(config.attention.head_dim);
+    const int qh = dimension(config.attention.num_attention_heads);
+    const int kh = dimension(config.attention.num_key_value_heads);
+    const int inter = dimension(config.intermediate_size), groups = h / 16;
+    const int rank = dimension(extra.selector_rank);
+    if (w < 2 || w > 16 || call.ids.ne[1] != 1 || call.drafts.ne[0] != k)
+        throw std::invalid_argument("Qwen4Exp DFlash2: proposal geometry is invalid");
+    auto scope    = arena.scope();
+    auto ids      = call.ids;
+    auto where    = call.positions;
+    auto residual = arena.alloc(DType::BF16, {h, w, 1});
+    ops::prepare_masked_block(call.anchors, call.frontiers, call.valid_columns,
+                              dimension(config.mask_token_id), ids, where, cuda);
+    {
+        auto flat = residual.view({h, w});
+        ops::embedding(ids.view({w}), parameters.text.embedding, flat, cuda);
+    }
+    auto normalized   = arena.alloc(DType::BF16, {h, w, 1});
+    auto prepared     = arena.alloc(DType::BF16, {h, w, 1});
+    auto branch       = arena.alloc(DType::BF16, {h, w, 1});
+    auto coefficients = arena.alloc(DType::BF16, {4 * groups, w});
+    auto q            = arena.alloc(DType::BF16, {d, qh, w, 1});
+    auto key          = arena.alloc(DType::BF16, {d, kh, w, 1});
+    auto value        = arena.alloc(DType::BF16, {d, kh, w, 1});
+    auto attention    = arena.alloc(DType::BF16, {d, qh, w, 1});
+    auto gate         = arena.alloc(DType::BF16, {inter, w});
+    auto up           = arena.alloc(DType::BF16, {inter, w});
+    const ops::AttentionHeadGeometry geometry{d, qh, kh};
+    const auto window = config.sliding_window.value();
+    const float scale = static_cast<float>(1.0 / std::sqrt(static_cast<double>(d)));
+    const auto flat   = [&](Tensor& t) { return t.view({h, w}); };
+    for (std::size_t l = 0; l < p.layers.size(); ++l) {
+        const auto& layer = p.layers[l];
+        {
+            ops::plain_rmsnorm_columns(residual, layer.input_norm, config.rms_norm_eps, w,
+                                       normalized, cuda);
+            project(flat(normalized), layer.attention_projection, coefficients, cuda);
+            ops::dynamic_conv_prepare(normalized, coefficients, layer.attention_base, prepared,
+                                      cuda);
+            auto qf = q.view({d * qh, w}), kf = key.view({d * kh, w}), vf = value.view({d * kh, w});
+            project(flat(prepared), layer.query, qf, cuda);
+            project(flat(prepared), layer.key, kf, cuda);
+            project(flat(prepared), layer.value, vf, cuda);
+            ops::rmsnorm_rope(where, layer.query_norm, layer.key_norm, config.rms_norm_eps,
+                              config.rope_theta, q, key, cuda);
+            {
+                auto scratch = arena.scope();
+                ops::sliding_window_attention(q, key, value, where, call.valid_columns, geometry,
+                                              window, scale, ring.layers[l],
+                                              {0, call.max_context}, arena, attention, cuda);
+            }
+            auto out = flat(branch);
+            project(attention.view({d * qh, w}), layer.output, out, cuda);
+            ops::dynamic_conv_add(branch, coefficients, layer.attention_base, residual, cuda);
+        }
+        {
+            ops::plain_rmsnorm_columns(residual, layer.post_attention_norm, config.rms_norm_eps, w,
+                                       normalized, cuda);
+            project(flat(normalized), layer.mlp_projection, coefficients, cuda);
+            ops::dynamic_conv_prepare(normalized, coefficients, layer.mlp_base, prepared, cuda);
+            project(flat(prepared), layer.gate, gate, cuda);
+            project(flat(prepared), layer.up, up, cuda);
+            ops::swiglu_product(gate, up, std::int64_t(inter) * w, gate, cuda);
+            auto out = flat(branch);
+            project(gate, layer.down, out, cuda);
+            ops::dynamic_conv_add(branch, coefficients, layer.mlp_base, residual, cuda);
+        }
+    }
+    auto hidden = arena.alloc(DType::BF16, {h, k});
+    ops::rmsnorm_tail(residual, p.final_norm, config.rms_norm_eps, hidden, cuda);
+    auto logits = arena.alloc(DType::BF16, {dimension(profile.local.vocabulary), k});
+    project_head(hidden, parameters.mtp->head, logits, arena, cuda);
+    auto candidates = call.candidates.view({16, k});
+    auto scores     = call.scores.view({16, k});
+    ops::logits_top16(logits, dimension(profile.public_tokens), k, candidates, scores, cuda);
+    auto projected = arena.alloc(DType::BF16, {rank, k});
+    project(hidden, p.selector, projected, cuda);
+    auto drafts = call.drafts;
+    auto law    = call.proposal_q;
+    ops::candidate_selector_path(call.candidates, call.scores, projected.view({rank, k, 1}),
+                                 call.anchors, p.predecessor_codebook, p.successor_codebook,
+                                 dimension(profile.public_tokens), call.frontiers, call.sampling,
+                                 drafts, law, arena, cuda);
+}
+
+} // namespace ninfer::models::qwen4_exp::execution
diff --git a/src/models/qwen4_exp/execution/dflash.h b/src/models/qwen4_exp/execution/dflash.h
new file mode 100644
index 0000000..d2e8af1
--- /dev/null
+++ b/src/models/qwen4_exp/execution/dflash.h
@@ -0,0 +1,43 @@
+#pragma once
+
+// The DFlash2 drafter of Qwen3.8-Flash-Next (incoai/Qwen3.8-Flash-Next-DFlash2): one masked block
+// [anchor, K masks] through five sliding-window layers with dynamic convolutions, conditioned on a
+// cyclic ring of context K/V projected from the target's features (the mean of the four
+// hyper-connection streams after blocks 5, 15, 25, 35 and 45), then the proposal head and the
+// conditional candidate selector. One row only. The caller owns the ring, the features and every
+// io word; nothing here keeps state.
+
+#include "core/arena.h"
+#include "core/cyclic_kv_cache.h"
+#include "models/qwen4_exp/execution/parameters.h"
+#include "ninfer/ops/sampling.h"
+
+#include <span>
+
+namespace ninfer::models::qwen4_exp::execution {
+
+struct DraftRing {
+    std::span<const CyclicKVCacheLayerView> layers;
+    std::span<Tensor> keys, values; // each layer's bound BF16 K and FP16 V [D, padded, Hkv]
+};
+
+// Projects `count` feature columns (features is BF16 [H, taps, C]) at positions[0..count) into
+// every layer's ring.
+void draft_append_context(const Parameters&, MemoryArena&, const Tensor& features,
+                          const Tensor& positions, std::int32_t count, const DraftRing&,
+                          CudaExecutionView);
+
+struct DraftProposal {
+    Tensor anchors, frontiers, valid_columns; // I32 [1]
+    const ops::SamplingConfig* sampling;       // device [1]
+    Tensor ids, positions;                     // I32 [W,1] scratch
+    Tensor candidates;                         // I32 [16,K,1]
+    Tensor scores, proposal_q;                 // FP32 [16,K,1]
+    Tensor drafts;                             // I32 [K,1]
+    std::uint32_t max_context = 0;
+};
+
+void draft_propose(const Parameters&, MemoryArena&, const DraftProposal&, const DraftRing&,
+                   CudaExecutionView);
+
+} // namespace ninfer::models::qwen4_exp::execution
