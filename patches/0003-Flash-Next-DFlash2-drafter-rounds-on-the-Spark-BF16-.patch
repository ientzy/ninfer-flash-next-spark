+                                  p.tensor(l.attention_conv.value().base_kernel),
+                                  p.tensor(l.mlp_conv.value().base_kernel),
+                                  p.linear({a.query}),
+                                  p.linear({a.key}),
+                                  p.linear({a.value}),
+                                  p.linear({a.context_key}),
+                                  p.linear({a.context_value}),
+                                  p.linear({a.output}),
+                                  p.linear({l.mlp.gate}),
