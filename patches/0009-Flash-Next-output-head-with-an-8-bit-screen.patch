diff --git a/include/ninfer/ops/head_screen.h b/include/ninfer/ops/head_screen.h
new file mode 100644
index 0000000..d94a629
--- /dev/null
+++ b/include/ninfer/ops/head_screen.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include "core/arena.h"
+#include "core/device.h"
+#include "core/tensor.h"
+#include "core/weight.h"
+#include "ninfer/ops/linear.h"
+
+#include <cstdint>
+
+// Output head with a screen. An 8-bit copy of a BF16 head [V,K] gives approximate logits; a bound
+// on its error per row tells which rows can be among the kHeadScreenKeep largest of a column, and
+// only those rows are computed from the BF16 head. Every other row gets kHeadScreenNone.
+//
+// For row v and a hidden column h, |W[v,:]h - W8[v,:]h| <= |W[v,:] - W8[v,:]| |h| (Cauchy-Schwarz),
+// with the row norm of the difference measured when the copy is made. A margin covers the BF16
+// rounding of the two results. So the published column holds the kHeadScreenKeep largest logits
+// (sampling.h never looks further) and its argmax; it does not hold a full distribution.
+// A published value is the FP32 dot product rounded to BF16; its last bit can differ from the
+// value ops::linear publishes, which sums in another order.
+
+namespace ninfer::ops {
+
+inline constexpr std::int32_t kHeadScreenKeep    = 20;
+inline constexpr std::int32_t kHeadScreenColumns = 16;
+inline constexpr float kHeadScreenNone           = -1.0e30F;
+
+// One call per group of 32 input rows of the head. weights is BF16 [V,32]: the head applied to
+// the group's 32 unit vectors. Writes that group of codes (I8, row-major [V,K]) and FP16 scales
+// (row-major [V,K/32]) and adds each row's squared error to error2 (FP32 [V], zero at the start).
+void head_screen_quantize(const Tensor& weights, std::int32_t group, Tensor& codes, Tensor& scales,
+                          std::int32_t input_rows, Tensor& error2, CudaExecutionView execution);
+// error2 -> its square root, in place.
+void head_screen_finish_error(Tensor& error2, CudaExecutionView execution);
+
+struct HeadScreenOperands {
+    const Weight* head   = nullptr; // BF16 Contiguous [V,K]
+    const Weight* screen = nullptr; // Q8_G32_FP16 RowSplit copy of it
+    LinearPolicy policy{};
+    Tensor error;    // FP32 [V]
+    Tensor approx;   // BF16 [V,kHeadScreenColumns] scratch
+    Tensor bounds;   // FP32 [2,kHeadScreenColumns] scratch
+    Tensor counters; // I64 [8]: columns, candidates, checked columns, missed, changed, argmax
+    std::int32_t valid = 0;
+};
+
+// logits [V,T] for hidden [K,T], T in [1,kHeadScreenColumns]. Rows at or beyond valid get
+// kHeadScreenNone. Graph capture is supported; the scratch tensors are overwritten.
+void head_screen(const Tensor& hidden, const HeadScreenOperands& operands, Tensor& logits,
+                 MemoryArena& workspace, CudaExecutionView execution);
+
+// Compares a screened [V,T] against ops::linear's [V,T]: counts the rows of the reference's top
+// kHeadScreenKeep that the screen left out (must stay zero), those whose value differs, and the
+// columns whose argmax differs.
+void head_screen_check(const Tensor& reference, const Tensor& screened,
+                       const HeadScreenOperands& operands, CudaExecutionView execution);
+
+} // namespace ninfer::ops
diff --git a/src/models/qwen4_exp/execution/head_screen.cpp b/src/models/qwen4_exp/execution/head_screen.cpp
new file mode 100644
index 0000000..e560d23
--- /dev/null
+++ b/src/models/qwen4_exp/execution/head_screen.cpp
@@ -0,0 +1,94 @@
+#include "models/qwen4_exp/execution/head_screen.h"
+#include "core/transfer.h"
+#include "models/qwen4_exp/execution/text.h"
+
+#include <algorithm>
+#include <vector>
+
+namespace ninfer::models::qwen4_exp::execution {
+
+std::unique_ptr<HeadScreen> make_head_screen(const Parameters& parameters, bool check,
+                                             MemoryArena& workspace, CudaExecutionView cuda) {
+    const auto& head  = parameters.text.head;
+    const int rows    = head.weight.n, hidden = head.weight.k;
+    const int columns = ops::kHeadScreenColumns, group = 32;
+    if (head.weight.qtype != QType::BF16 || rows != 248320 || hidden != 2560) return nullptr;
+    auto screen   = std::make_unique<HeadScreen>();
+    screen->check = check;
+    const std::size_t bytes = std::size_t(rows) * hidden + std::size_t(rows) * (hidden / group) * 2 +
+                              std::size_t(rows) * 4 + 2 * std::size_t(rows) * columns * 2 +
+                              (std::size_t(1) << 20);
+    screen->storage = DeviceBuffer(cuda.device(), bytes);
+    screen->storage.fill(0);
+    MemoryArena arena(screen->storage.span());
+    auto codes    = arena.alloc(DType::I8, {hidden, rows});
+    auto scales   = arena.alloc(DType::FP16, {hidden / group, rows});
+    auto error    = arena.alloc(DType::FP32, {rows});
+    auto approx   = arena.alloc(DType::BF16, {rows, columns});
+    screen->shadow = arena.alloc(DType::BF16, {rows, columns});
+    auto bounds   = arena.alloc(DType::FP32, {2, columns});
+    auto counters = arena.alloc(DType::I64, {8});
+    {
+        // The head applied to unit vectors gives its own values, whatever its storage layout.
+        DeviceBuffer scratch(cuda.device(), std::size_t(rows) * group * 2 + (std::size_t(1) << 20));
+        scratch.fill(0);
+        MemoryArena temporary(scratch.span());
+        auto basis   = temporary.alloc(DType::BF16, {hidden, group});
+        auto weights = temporary.alloc(DType::BF16, {rows, group});
+        std::vector<std::uint16_t> host(std::size_t(hidden) * group);
+        for (int first = 0; first < hidden; first += group) {
+            std::fill(host.begin(), host.end(), std::uint16_t{0});
+            for (int j = 0; j < group; ++j) host[std::size_t(j) * hidden + first + j] = 0x3F80;
+            copy_bytes({basis.data, host.size() * 2, cuda.device()},
+                       {host.data(), host.size() * 2, Device::cpu()}, cuda);
+            project_head(basis, head, weights, workspace, cuda);
+            ops::head_screen_quantize(weights, first / group, codes, scales, hidden, error, cuda);
+        }
+        ops::head_screen_finish_error(error, cuda);
+        // The copies above are synchronous, but the last kernels are not: wait before scratch dies.
+        std::uint32_t done = 0;
+        copy_bytes({&done, sizeof(done), Device::cpu()}, {error.data, sizeof(done), cuda.device()},
+                   cuda);
+    }
+    auto& w           = screen->copy;
+    w.device          = cuda.device();
+    w.payload         = codes.data;
+    w.payload_bytes   = std::size_t(rows) * hidden;
+    w.qtype           = QType::Q8_G32_FP16;
+    w.group_size      = group;
+    w.shape[0]        = rows;
+    w.shape[1]        = hidden;
+    w.padded_shape[0] = rows;
+    w.padded_shape[1] = hidden;
+    w.ndim            = 2;
+    w.qdata           = codes.data;
+    w.scales          = scales.data;
+    w.n               = rows;
+    w.k               = hidden;
+    w.group           = group;
+    w.layout          = QuantLayout::RowSplit;
+    screen->operands  = {&head.weight, &screen->copy, head.policy, error, approx, bounds, counters,
+                         dimension(parameters.profile->public_tokens)};
+    return screen;
+}
+
+void project_head_screened(const Tensor& sample, const HeadScreen& screen, Tensor& logits,
+                           MemoryArena& workspace, CudaExecutionView cuda) {
+    auto scope = workspace.scope();
+    if (!screen.check) {
+        ops::head_screen(sample, screen.operands, logits, workspace, cuda);
+        return;
+    }
+    auto shadow = screen.shadow.slice(1, 0, logits.ne[1]);
+    ops::head_screen(sample, screen.operands, shadow, workspace, cuda);
+    ops::head_screen_check(logits, shadow, screen.operands, cuda);
+}
+
+std::array<std::uint64_t, 6> HeadScreen::counters(CudaExecutionView cuda) const {
+    std::array<std::uint64_t, 6> out{};
+    copy_bytes({out.data(), sizeof(out), Device::cpu()},
+               {operands.counters.data, sizeof(out), cuda.device()}, cuda);
+    return out;
+}
+
+} // namespace ninfer::models::qwen4_exp::execution
