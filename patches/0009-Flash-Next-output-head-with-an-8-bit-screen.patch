@@ -0,0 +1,36 @@
+#pragma once
+
+#include "core/buffer.h"
+#include "models/qwen4_exp/execution/parameters.h"
+#include "ninfer/ops/head_screen.h"
+
+#include <array>
+#include <memory>
+
+namespace ninfer::models::qwen4_exp::execution {
+
+// The output head with a screen (ninfer/ops/head_screen.h): the 8-bit copy of the text head, made
+// when the program starts, and the scratch the Op needs. A round may use it when no row has a
+// grammar mask or a penalty, because sampling then reads only the 20 largest logits.
+struct HeadScreen {
+    DeviceBuffer storage;
+    Weight copy;
+    ops::HeadScreenOperands operands;
+    Tensor shadow; // BF16 [V,kHeadScreenColumns]: the screened logits of a check round
+    bool check                = false;
+    std::uint64_t rounds      = 0;
+    std::uint64_t full_rounds = 0;
+
+    // columns, candidates, checked columns, missed, changed, argmax changed
+    [[nodiscard]] std::array<std::uint64_t, 6> counters(CudaExecutionView) const;
+};
+
+[[nodiscard]] std::unique_ptr<HeadScreen> make_head_screen(const Parameters&, bool check,
+                                                           MemoryArena& workspace,
+                                                           CudaExecutionView);
+
+// logits [V,T] of sample [K,T]. In a check round logits must already hold the full head's result.
+void project_head_screened(const Tensor& sample, const HeadScreen&, Tensor& logits,
+                           MemoryArena& workspace, CudaExecutionView);
+
+} // namespace ninfer::models::qwen4_exp::execution
