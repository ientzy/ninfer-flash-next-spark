new file mode 100644
index 0000000..12faf07
--- /dev/null
+++ b/src/ops/head_screen/head_screen.cu
@@ -0,0 +1,304 @@
+#include "ninfer/ops/head_screen.h"
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <climits>
+#include <cmath>
+#include <cstdint>
+#include <stdexcept>
+
+namespace ninfer::ops {
+namespace {
+
+using bf16 = __nv_bfloat16;
+constexpr int kThreads = 1024;
+
+void require(bool ok, const char* message) {
+    if (!ok) throw std::invalid_argument(message);
+}
+
+void check_launch() { CUDA_CHECK(cudaGetLastError()); }
+
+// How far the BF16 head's published logit can be from the 8-bit one: the row's error norm times
+// the column's norm, plus the BF16 rounding of both values (at most 1/128 of the value each,
+// taken as 1/64 together) and a small constant for values near zero and FP32 summation.
+__device__ __forceinline__ float margin(float approx, float error, float norm) {
+    return error * norm * 1.002F + fabsf(approx) * (1.0F / 64.0F) + 0.02F;
+}
+
+__global__ void quantize_kernel(const bf16* weights, std::int8_t* codes, int input_rows,
+                                __half* scales, int group, float* error2, int rows) {
+    const int v = blockIdx.x * blockDim.x + threadIdx.x;
+    if (v >= rows) return;
+    float largest = 0;
+    for (int c = 0; c < 32; ++c)
+        largest = fmaxf(largest, fabsf(__bfloat162float(weights[std::int64_t(c) * rows + v])));
+    const __half stored = __float2half(largest / 127.0F);
+    const float step    = __half2float(stored);
+    float error         = 0;
+    for (int c = 0; c < 32; ++c) {
+        const float w = __bfloat162float(weights[std::int64_t(c) * rows + v]);
+        float q       = step > 0 ? rintf(w / step) : 0.0F;
+        q             = fminf(127.0F, fmaxf(-127.0F, q));
+        codes[std::int64_t(v) * input_rows + group * 32 + c] = static_cast<std::int8_t>(q);
+        error += (w - q * step) * (w - q * step);
+    }
+    scales[std::int64_t(v) * (input_rows / 32) + group] = stored;
+    error2[v] += error;
+}
+
+__global__ void sqrt_kernel(float* values, int count) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < count) values[i] = sqrtf(values[i]);
+}
+
+// One block per column. bounds[2c] = |h|, bounds[2c+1] = a value that at least kHeadScreenKeep
+// rows surely reach: each thread takes the largest lower bound of its own rows, and the
+// kHeadScreenKeep-th largest of those is the threshold (the rows behind it are distinct).
+__global__ void threshold_kernel(const bf16* hidden, int input_rows, const bf16* approx,
+                                 int stride, const float* error, int valid, float* bounds,
+                                 unsigned long long* counters) {
+    __shared__ float best[kThreads];
+    __shared__ float shared_norm;
+    const int t   = threadIdx.x;
+    const bf16* x = hidden + std::int64_t(blockIdx.x) * input_rows;
+    const bf16* a = approx + std::int64_t(blockIdx.x) * stride;
+    float sum     = 0;
+    for (int j = t; j < input_rows; j += kThreads) {
+        const float value = __bfloat162float(x[j]);
+        sum += value * value;
+    }
+    best[t] = sum;
+    __syncthreads();
+    if (t == 0) {
+        float total = 0;
+        for (int i = 0; i < kThreads; ++i) total += best[i];
+        shared_norm = sqrtf(total);
+    }
+    __syncthreads();
+    const float norm = shared_norm;
+    float top        = -INFINITY;
+    for (int v = t; v < valid; v += kThreads) {
+        const float value = __bfloat162float(a[v]);
+        top               = fmaxf(top, value - margin(value, error[v], norm));
+    }
+    __syncthreads();
+    best[t] = top;
+    __syncthreads();
+    if (!isfinite(norm)) {
+        // A column without finite values has no meaning to keep; publish nothing for it.
+        if (t == 0) {
+            bounds[2 * blockIdx.x]     = 0.0F;
+            bounds[2 * blockIdx.x + 1] = INFINITY;
+        }
+        return;
+    }
+    int rank = 0;
+    for (int j = 0; j < kThreads; ++j) {
+        const float other = best[j];
+        rank += (other > top || (other == top && j < t)) ? 1 : 0;
+    }
+    if (rank == kHeadScreenKeep - 1) {
+        bounds[2 * blockIdx.x]     = norm;
+        bounds[2 * blockIdx.x + 1] = top;
+        atomicAdd(counters, 1ULL);
+    }
+}
+
+// One thread per row of the head. A row that can reach a column's threshold gets its exact
+// FP32 dot product for that column; every other entry gets kHeadScreenNone.
+__global__ void rescore_kernel(const bf16* weight, int input_rows, const bf16* hidden,
+                               const bf16* approx, const float* error, const float* bounds,
+                               bf16* logits, int rows, int valid, int columns,
+                               unsigned long long* counters) {
+    const int v = blockIdx.x * blockDim.x + threadIdx.x;
+    if (v >= rows) return;
+    const bf16 none = __float2bfloat16_rn(kHeadScreenNone);
+    unsigned keep   = 0;
+    if (v < valid) {
+        const float e = error[v];
+        for (int c = 0; c < columns; ++c) {
+            const float a = __bfloat162float(approx[std::int64_t(c) * rows + v]);
+            if (a + margin(a, e, bounds[2 * c]) >= bounds[2 * c + 1]) keep |= 1U << c;
+        }
+    }
+    for (int c = 0; c < columns; ++c)
+        if (!((keep >> c) & 1U)) logits[std::int64_t(c) * rows + v] = none;
+    if (!keep) return;
+    const bf16* w = weight + std::int64_t(v) * input_rows;
+    int found     = 0;
+    for (int c = 0; c < columns; ++c) {
+        if (!((keep >> c) & 1U)) continue;
+        const bf16* x = hidden + std::int64_t(c) * input_rows;
+        float sums[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+        for (int j = 0; j < input_rows; j += 8)
+            for (int u = 0; u < 8; ++u)
+                sums[u] += __bfloat162float(w[j + u]) * __bfloat162float(x[j + u]);
+        const float sum = ((sums[0] + sums[1]) + (sums[2] + sums[3])) +
+                          ((sums[4] + sums[5]) + (sums[6] + sums[7]));
+        logits[std::int64_t(c) * rows + v] = __float2bfloat16_rn(sum);
+        ++found;
+    }
+    atomicAdd(counters + 1, static_cast<unsigned long long>(found));
+}
+
+// One block per column: the reference's kHeadScreenKeep-th largest value (with repeats), then
+// the rows at or above it that the screen left out or published with another value.
+__global__ void check_kernel(const bf16* reference, const bf16* screened, int stride, int valid,
+                             unsigned long long* counters) {
+    __shared__ float values[kThreads];
+    __shared__ int counts[kThreads];
+    __shared__ int ids[kThreads];
+    __shared__ float shared_value;
+    __shared__ int shared_count;
+    __shared__ int shared_done;
+    const int t     = threadIdx.x;
+    const bf16* r   = reference + std::int64_t(blockIdx.x) * stride;
+    const bf16* s   = screened + std::int64_t(blockIdx.x) * stride;
+    float previous  = INFINITY;
+    float threshold = -INFINITY;
+    if (t == 0) {
+        shared_count = 0;
+        shared_done  = 0;
+    }
+    __syncthreads();
+    for (int round = 0; round < kHeadScreenKeep; ++round) {
+        float best = -INFINITY;
+        for (int v = t; v < valid; v += kThreads) {
+            const float value = __bfloat162float(r[v]);
+            if (value < previous && value > best) best = value;
+        }
+        values[t] = best;
+        __syncthreads();
+        if (t == 0) {
+            float m = -INFINITY;
+            for (int i = 0; i < kThreads; ++i) m = fmaxf(m, values[i]);
+            shared_value = m;
+        }
+        __syncthreads();
+        const float current = shared_value;
+        int same            = 0;
+        for (int v = t; v < valid; v += kThreads) same += __bfloat162float(r[v]) == current;
+        counts[t] = same;
+        __syncthreads();
+        if (t == 0 && !shared_done) {
+            int total = 0;
+            for (int i = 0; i < kThreads; ++i) total += counts[i];
+            shared_count += total;
+            if (shared_count >= kHeadScreenKeep) shared_done = round + 1;
+        }
+        __syncthreads();
+        if (shared_done && threshold == -INFINITY) threshold = current;
+        previous = current;
+        __syncthreads();
+    }
+    const bf16 none = __float2bfloat16_rn(kHeadScreenNone);
+    int missed = 0, changed = 0;
+    float top[2]  = {-INFINITY, -INFINITY};
+    int top_id[2] = {INT_MAX, INT_MAX};
+    for (int v = t; v < valid; v += kThreads) {
+        const float a = __bfloat162float(r[v]), b = __bfloat162float(s[v]);
+        if (a >= threshold) {
+            if (b == __bfloat162float(none))
+                ++missed;
+            else if (a != b)
+                ++changed;
+        }
+        if (a > top[0]) {
+            top[0]    = a;
+            top_id[0] = v;
+        }
+        if (b > top[1]) {
+            top[1]    = b;
+            top_id[1] = v;
+        }
+    }
+    int winner[2];
+    for (int side = 0; side < 2; ++side) {
+        values[t] = top[side];
+        ids[t]    = top_id[side];
+        __syncthreads();
+        if (t == 0) {
+            int best = 0;
+            for (int i = 1; i < kThreads; ++i)
+                if (values[i] > values[best] || (values[i] == values[best] && ids[i] < ids[best]))
+                    best = i;
+            shared_count = ids[best];
+        }
+        __syncthreads();
+        winner[side] = shared_count;
+        __syncthreads();
+    }
+    counts[t] = missed;
+    ids[t]    = changed;
+    __syncthreads();
+    if (t == 0) {
+        unsigned long long all_missed = 0, all_changed = 0;
+        for (int i = 0; i < kThreads; ++i) {
+            all_missed += counts[i];
+            all_changed += ids[i];
+        }
+        atomicAdd(counters + 2, 1ULL);
+        atomicAdd(counters + 3, all_missed);
+        atomicAdd(counters + 4, all_changed);
+        atomicAdd(counters + 5, winner[0] != winner[1] ? 1ULL : 0ULL);
+    }
+}
+
+} // namespace
+
+void head_screen_quantize(const Tensor& weights, std::int32_t group, Tensor& codes, Tensor& scales,
+                          std::int32_t input_rows, Tensor& error2, CudaExecutionView execution) {
+    const int rows = weights.ne[0];
+    require(weights.dtype == DType::BF16 && weights.ne[1] == 32 && input_rows % 32 == 0 &&
+                group >= 0 && group < input_rows / 32 && error2.ne[0] == rows,
+            "head_screen_quantize: unexpected shapes");
+    quantize_kernel<<<(rows + 255) / 256, 256, 0, execution.stream()>>>(
+        static_cast<const bf16*>(weights.data), static_cast<std::int8_t*>(codes.data), input_rows,
+        static_cast<__half*>(scales.data), group, static_cast<float*>(error2.data), rows);
+    check_launch();
+}
+
+void head_screen_finish_error(Tensor& error2, CudaExecutionView execution) {
+    const int rows = error2.ne[0];
+    sqrt_kernel<<<(rows + 255) / 256, 256, 0, execution.stream()>>>(
+        static_cast<float*>(error2.data), rows);
+    check_launch();
+}
+
+void head_screen(const Tensor& hidden, const HeadScreenOperands& o, Tensor& logits,
+                 MemoryArena& workspace, CudaExecutionView execution) {
+    const int columns = hidden.ne[1], rows = logits.ne[0], input_rows = hidden.ne[0];
+    require(o.head && o.screen && o.head->qtype == QType::BF16 && o.head->n == rows &&
+                o.head->k == input_rows && o.screen->n == rows && o.screen->k == input_rows,
+            "head_screen: the two heads differ from the logits");
+    require(columns >= 1 && columns <= kHeadScreenColumns && logits.ne[1] == columns &&
+                o.valid >= kThreads * kHeadScreenKeep && o.valid <= rows && input_rows % 8 == 0,
+            "head_screen: unsupported extent");
+    auto approx = o.approx.slice(1, 0, columns);
+    linear(hidden, *o.screen, approx, o.policy, workspace, execution);
+    auto* counters = static_cast<unsigned long long*>(o.counters.data);
+    threshold_kernel<<<columns, kThreads, 0, execution.stream()>>>(
+        static_cast<const bf16*>(hidden.data), input_rows, static_cast<const bf16*>(approx.data),
+        rows, static_cast<const float*>(o.error.data), o.valid,
+        static_cast<float*>(o.bounds.data), counters);
+    check_launch();
+    rescore_kernel<<<(rows + 255) / 256, 256, 0, execution.stream()>>>(
+        static_cast<const bf16*>(o.head->qdata), input_rows, static_cast<const bf16*>(hidden.data),
+        static_cast<const bf16*>(approx.data), static_cast<const float*>(o.error.data),
+        static_cast<const float*>(o.bounds.data), static_cast<bf16*>(logits.data), rows, o.valid,
+        columns, counters);
+    check_launch();
+}
+
+void head_screen_check(const Tensor& reference, const Tensor& screened,
+                       const HeadScreenOperands& o, CudaExecutionView execution) {
+    require(reference.ne[0] == screened.ne[0] && reference.ne[1] == screened.ne[1],
+            "head_screen_check: shapes differ");
+    check_kernel<<<reference.ne[1], kThreads, 0, execution.stream()>>>(
+        static_cast<const bf16*>(reference.data), static_cast<const bf16*>(screened.data),
+        reference.ne[0], o.valid, static_cast<unsigned long long*>(o.counters.data));
+    check_launch();
+}
+
+} // namespace ninfer::ops
