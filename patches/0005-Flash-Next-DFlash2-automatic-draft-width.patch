+std::uint32_t DraftRuntime::choose(const float* confidence, std::uint32_t extent) {
+    std::uint32_t best = extent;
+    double keep = 1, tokens = 1, expected = 0, best_score = -1, best_expected = 0;
+    for (std::uint32_t j = 1; j <= extent; ++j) {
+        const double p = std::min(1.0, std::max(0.0, double(confidence[j - 1])));
+        keep *= std::pow(p, auto_power);
+        tokens += keep;
+        expected += keep;
+        const double score = tokens / (auto_cost + j + 1);
+        if (auto_cost > 0 && score > best_score) {
+            best_score    = score;
+            best          = j;
+            best_expected = expected;
+        }
+    }
+    pending_predicted = auto_cost > 0 ? best_expected : expected;
+    return best;
+}
