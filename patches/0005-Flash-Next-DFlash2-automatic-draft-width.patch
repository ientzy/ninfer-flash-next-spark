+// One block per draft position: the selector's edge scores of its 16 candidates given the chosen
+// predecessor, and the temperature-1 softmax probability of the chosen draft.
+__global__ void selector_confidence_kernel(const std::int32_t* candidates, const float* scores,
+                                           const bf16* projected, const std::int32_t* anchors,
+                                           const bf16* predecessor, const bf16* successor,
+                                           const std::int32_t* drafts, float* out) {
+    __shared__ float partial[16][8];
+    const int i = blockIdx.x, r = threadIdx.x;
+    const int before = i == 0 ? anchors[0] : drafts[i - 1];
+    const float left = __bfloat162float(predecessor[std::int64_t(before) * 256 + r]) *
+                       __bfloat162float(projected[i * 256 + r]);
+    for (int c = 0; c < 16; ++c) {
+        const int id = candidates[i * 16 + c];
+        float sum    = left * __bfloat162float(successor[std::int64_t(id) * 256 + r]);
+        for (int offset = 16; offset > 0; offset >>= 1)
+            sum += __shfl_down_sync(0xffffffffU, sum, offset);
+        if ((r & 31) == 0) partial[c][r >> 5] = sum;
+    }
+    __syncthreads();
+    if (r != 0) return;
+    float edge[16], best = -INFINITY;
+    for (int c = 0; c < 16; ++c) {
+        float sum = scores[i * 16 + c];
+        for (int w = 0; w < 8; ++w) sum += partial[c][w];
+        edge[c] = sum;
+        best    = fmaxf(best, sum);
+    }
+    float total = 0, chosen = 0;
+    for (int c = 0; c < 16; ++c) {
+        const float e = __expf(edge[c] - best);
+        total += e;
+        if (candidates[i * 16 + c] == drafts[i]) chosen = e;
+    }
+    out[i] = chosen / total;
+}
+
 constexpr int kTop = 16, kTopThreads = 1024;
 
 __device__ inline bool better(float a, int ia, float b, int ib) {
@@ -391,6 +427,24 @@ void swiglu_packed(const Tensor& gate_up, Tensor& out, CudaExecutionView executi
     check_launch();
 }
 
+void selector_confidence(const Tensor& candidates, const Tensor& scores, const Tensor& projected,
+                         const Tensor& anchors, const Tensor& predecessor, const Tensor& successor,
+                         const Tensor& drafts, Tensor& out, CudaExecutionView execution) {
+    const int k = drafts.ne[0];
