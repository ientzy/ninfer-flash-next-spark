@@ -1,11 +1,49 @@
 #include "models/qwen4_exp/session/internal.h"
 
 #include <algorithm>
+#include <cstdlib>
 
 namespace ninfer::models::qwen4_exp {
 namespace {
 using Kind = detail::ComputeTransaction::Kind;
 
+// Prompt lookup (ported idea from Cinference's DFlash2 lookup rounds): when the newest tokens repeat
+// an earlier stretch of the sequence, the tokens that followed it are verified as the drafts.
+// NINFER_PROMPT_LOOKUP=<suffix length, at least 2> enables it; unset or 0 keeps every round on MTP.
+std::uint32_t lookup_suffix() {
+    static const std::uint32_t value = [] {
+        const char* text = std::getenv("NINFER_PROMPT_LOOKUP");
+        const auto n     = text ? std::strtoul(text, nullptr, 10) : 0UL;
+        return n >= 2 && n <= 64 ? static_cast<std::uint32_t>(n) : 0U;
+    }();
+    return value;
+}
+
+// The `want` tokens that followed the earlier occurrence sharing the longest run of tokens with the
+// end of the sequence (at least `suffix`; the latest one among equals). Empty when there is none or
+// fewer than `want` tokens follow it.
+std::vector<TokenId> lookup_chain(std::span<const TokenId> tokens, std::uint32_t want,
+                                  std::uint32_t suffix) {
+    constexpr std::size_t kLongest = 48;
+    const auto n = tokens.size();
+    if (!want || !suffix || n < suffix + want + 1) return {};
+    const auto* tail = tokens.data() + n - suffix;
+    std::size_t best = 0, best_end = 0;
+    for (std::size_t end = n - want; end >= suffix; --end) {
+        if (tokens[end - 1] != tokens[n - 1]) continue;
+        if (!std::equal(tail, tail + suffix, tokens.data() + end - suffix)) continue;
+        std::size_t run = suffix;
+        while (run < kLongest && run < end && tokens[end - 1 - run] == tokens[n - 1 - run]) ++run;
+        if (run > best) {
+            best     = run;
+            best_end = end;
+            if (run == kLongest) break;
+        }
+    }
+    if (!best) return {};
+    return {tokens.begin() + best_end, tokens.begin() + best_end + want};
+}
+
 void submit(detail::SessionImpl& session, runtime::ExecutionReservation reservation, Work work) {
     auto& tx = *session.compute;
     tx.context.prepare_actions();
@@ -120,6 +158,26 @@ Session::start_decode(std::span<const SequenceHandle> members,
                                p.shape.max_context - f - 1});
         speculative |= extents[b] != 0;
     }
+    // One lane only: a lookup round replaces the whole batch's MTP chain.
+    std::vector<std::vector<TokenId>> lookup;
+    if (speculative && members.size() == 1 && lookup_suffix() && extents[0] >= 2) {
+        auto& s = p.sequence(members[0]);
+        if (s.lookup_last) {
+            const auto drafted  = s.speculative.drafted_tokens - s.lookup_drafted;
+            const auto accepted = s.speculative.accepted_tokens - s.lookup_accepted;
+            if (accepted * 2 < drafted) s.lookup_cooldown = 3;
+            s.lookup_last = false;
+        }
+        if (s.lookup_cooldown)
+            --s.lookup_cooldown;
+        else if (auto chain = lookup_chain(s.identity.tokens, extents[0], lookup_suffix());
+                 !chain.empty()) {
+            lookup.push_back(std::move(chain));
+            s.lookup_last     = true;
+            s.lookup_drafted  = s.speculative.drafted_tokens;
+            s.lookup_accepted = s.speculative.accepted_tokens;
+        }
+    }
     auto reservation = p.executor->try_reserve(runtime::FrameKind::Compute);
     if (!reservation) return {};
     p.compute = std::make_unique<detail::ComputeTransaction>(
@@ -140,7 +198,7 @@ Session::start_decode(std::span<const SequenceHandle> members,
         }
         Work work;
         if (speculative)
-            work.operation = MtpWork{tx.rows, tx.extents};
+            work.operation = MtpWork{tx.rows, tx.extents, std::move(lookup)};
         else
             work.operation = ForwardWork{ForwardKind::Ordinary, SampleKind::NextToken, tx.rows, {}};
         submit(p, std::move(*reservation), std::move(work));
