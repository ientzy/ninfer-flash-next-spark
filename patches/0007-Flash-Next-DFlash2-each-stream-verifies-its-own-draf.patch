+    } else if (d.auto_cost > 0 && d.narrow_rows) {
+        // Every row keeps its first draft and a constrained row its whole window. The other
+        // drafts are taken best first, by the tokens each is expected to add, and the round
+        // uses the count with the best expected tokens per cost.
+        std::array<std::uint32_t, kMaximumConcurrency> taken{};
+        std::array<std::array<std::uint32_t, kMaximumConcurrency>, 17> plan{};
+        double tokens = rows, best = -1;
+        std::uint32_t used = 0;
+        for (std::uint32_t b = 0; b < rows; ++b) {
+            taken[b] = all[b].constrained ? extents[b] : 1;
+            tokens += kept[b][taken[b]];
+            used += taken[b];
+        }
+        for (std::uint32_t t = 2; t <= d.width; ++t) {
+            const auto slots = (t - 1) * rows;
+            while (used < slots) {
+                std::uint32_t pick = rows;
+                double gain        = -1;
+                for (std::uint32_t b = 0; b < rows; ++b) {
+                    if (taken[b] >= extents[b]) continue;
+                    const double g = kept[b][taken[b] + 1] - kept[b][taken[b]];
+                    if (g > gain) {
+                        gain = g;
+                        pick = b;
+                    }
+                }
+                if (pick == rows) break;
+                ++taken[pick];
+                ++used;
+                tokens += gain;
+            }
+            if (used > slots) continue; // constrained rows need a wider round than this
+            const double score = tokens / (d.auto_cost + d.row_cost * rows + double(t) * rows);
+            plan[t]            = taken;
+            if (score > best) {
