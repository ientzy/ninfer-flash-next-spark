+                const auto count = (chosen + 1) * rows;
+                std::uint32_t n  = 0;
+                for (std::uint32_t b = 0; b < rows; ++b)
+                    for (std::uint32_t j = 0; j <= own[b]; ++j)
+                        list[n++] = static_cast<std::int32_t>(b * d.width + j);
+                for (std::uint32_t b = 0; b < rows && n < count; ++b)
+                    for (std::uint32_t j = own[b] + 1; j < d.width && n < count; ++j)
+                        list[n++] = static_cast<std::int32_t>(b * d.width + j);
+                send(d.columns, list.data(), count * sizeof(std::int32_t));
+                compute->compact = chosen + 1;
+            }
+        }
     }
     out.clear();
     for (std::uint32_t b = 0; b < rows; ++b) {
-        const auto own = std::min(chosen, extents[b]);
-        lanes[b]->pending_predicted = kept[b][own];
-        out.emplace_back(ids.begin() + b * k, ids.begin() + b * k + own);
+        lanes[b]->pending_predicted = kept[b][own[b]];
+        out.emplace_back(ids.begin() + b * k, ids.begin() + b * k + own[b]);
     }
     ++d.widths[chosen];
     ++d.proposals;
+    const auto now = std::chrono::steady_clock::now();
+    if (d.last_rows == rows) {
+        const double seconds = std::chrono::duration<double>(now - d.last_round).count();
+        if (seconds < 1) {
+            d.round_seconds[rows] += seconds;
+            ++d.round_count[rows];
+        }
+    }
+    d.last_round = now;
+    d.last_rows  = rows;
     return true;
 }
 
